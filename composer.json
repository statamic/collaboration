{
    "name": "statamic/collaboration",
    "type": "statamic-addon",
    "description": "Real-time collaboration and multi-user authoring for Statamic Pro.",
    "license": "proprietary",
    "require": {
        "statamic/cms": "^6.15.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Statamic\\Collaboration\\ServiceProvider"
            ]
        },
        "statamic": {
            "name": "Collaboration",
            "description": "Real-time collaboration and multi-user authoring for Statamic Pro."
        }
    },
    "autoload": {
        "psr-4": {
            "Statamic\\Collaboration\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Statamic\\Collaboration\\Tests\\": "tests"
        }
    }
}
